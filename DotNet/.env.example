# Kopiér til .env og udfyld værdier før deploy.
# cp .env.example .env

# Offentlig URL (Traefik Host rule)
H3_HOST=h3.mercantec.tech

# Traefik-netværk og TLS (tilpas til jeres server)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Infisical Machine Identity (kun ApiService)
INFISICAL__CLIENTID=
INFISICAL__CLIENTSECRET=
INFISICAL__PROJECTID=
INFISICAL__ENVIRONMENTSLUG=prod
INFISICAL__SECRETPATH=/
INFISICAL__HOSTURI=https://infisical.mags.dk/
