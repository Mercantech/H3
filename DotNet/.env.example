# Sæt disse som environment variables i Dokploy (eller kopiér til .env lokalt).

# Offentlig URL (Traefik Host rule)
APP_DOMAIN=h3.mercantec.tech

# Infisical Machine Identity (kun ApiService)
INFISICAL__CLIENTID=
INFISICAL__CLIENTSECRET=
INFISICAL__PROJECTID=
INFISICAL__ENVIRONMENTSLUG=prod
INFISICAL__SECRETPATH=/
INFISICAL__HOSTURI=https://infisical.mags.dk/
