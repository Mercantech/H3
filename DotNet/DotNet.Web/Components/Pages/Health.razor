@page "/health"
@rendermode InteractiveServer
@using Microsoft.Extensions.Diagnostics.HealthChecks
@inject HealthApiClient HealthApi
@inject HealthCheckService HealthChecks

<PageTitle>Healthchecks — Redis &amp; Postgres</PageTitle>

<section class="health-hero">
    <div class="health-hero__top">
        <div>
            <p class="health-eyebrow">Infrastructure status</p>
            <h1>Healthchecks</h1>
        </div>
        <button class="health-refresh" type="button" @onclick="RefreshAsync" disabled="@isLoading">
            @if (isLoading)
            {
                <span>Tjekker…</span>
            }
            else
            {
                <span>↻ Kør healthchecks</span>
            }
        </button>
    </div>
    <p class="health-lead">
        Kører <code>GET /health</code> mod ApiService (Redis + Postgres) og den lokale Web-host (Redis output cache).
        Samme endpoints bruges af Docker/Aspire readiness probes.
    </p>
</section>

@if (isLoading && apiResult is null && webReport is null)
{
    <p class="health-loading"><em>Henter status…</em></p>
}
else
{
    <div class="health-grid">
        <article class="health-card health-card--@StatusClass(apiResult?.Success == true && IsHealthy(apiResult?.Report?.Status))">
            <header class="health-card__header">
                <h2>ApiService</h2>
                <span class="health-badge">@OverallLabel(apiResult)</span>
            </header>
            <p class="health-card__meta">
                @if (apiResult is not null)
                {
                    <span><code>@apiResult.Path</code> · @apiResult.DurationMs ms · HTTP @apiResult.StatusCode</span>
                }
                else
                {
                    <span>Ikke kørt endnu</span>
                }
            </p>
            @if (apiResult?.Error is not null)
            {
                <p class="health-card__error">@apiResult.Error</p>
            }
            <ul class="health-checks">
                @foreach (var check in apiResult?.Report?.Checks ?? [])
                {
                    <li class="health-check health-check--@check.Status.ToLowerInvariant()">
                        <div class="health-check__row">
                            <strong>@check.Name</strong>
                            <span>@check.Status</span>
                        </div>
                        <p>@CheckHint(check.Name) · @check.DurationMs.ToString("0.##") ms</p>
                        @if (!string.IsNullOrWhiteSpace(check.Error))
                        {
                            <p class="health-check__error">@check.Error</p>
                        }
                    </li>
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(apiResult?.RawBody))
            {
                <details class="health-raw">
                    <summary>Raw JSON</summary>
                    <pre>@apiResult.RawBody</pre>
                </details>
            }
        </article>

        <article class="health-card health-card--@StatusClass(webReport is not null && webReport.Status == HealthStatus.Healthy)">
            <header class="health-card__header">
                <h2>Web (Blazor)</h2>
                <span class="health-badge">@(webReport?.Status.ToString() ?? "—")</span>
            </header>
            <p class="health-card__meta">
                @if (webReport is not null)
                {
                    <span><code>/health</code> · @webDurationMs ms · lokal HealthCheckService</span>
                }
                else
                {
                    <span>Ikke kørt endnu</span>
                }
            </p>
            <ul class="health-checks">
                @if (webReport is not null)
                {
                    @foreach (var entry in webReport.Entries.OrderBy(e => e.Key))
                    {
                        <li class="health-check health-check--@entry.Value.Status.ToString().ToLowerInvariant()">
                            <div class="health-check__row">
                                <strong>@entry.Key</strong>
                                <span>@entry.Value.Status</span>
                            </div>
                            <p>@CheckHint(entry.Key) · @entry.Value.Duration.TotalMilliseconds.ToString("0.##") ms</p>
                            @if (entry.Value.Exception is not null)
                            {
                                <p class="health-check__error">@entry.Value.Exception.Message</p>
                            }
                        </li>
                    }
                }
            </ul>
        </article>
    </div>
}

<section class="health-admin">
    <h2>Admin-paneler</h2>
    <p>Postgres og Redis har dedikerede admin-UI’er i docker-compose (Traefik-hosts i produktion).</p>
    <ul>
        <li><strong>pgweb</strong> — <code>h3-pgweb.mercantec.tech</code> (let Postgres-UI, auto-forbundet til <code>h3</code>)</li>
        <li><strong>Redis Commander</strong> — <code>h3-redis.mercantec.tech</code> (host <code>redis:6379</code>)</li>
    </ul>
</section>

@code {
    private HealthProbeResult? apiResult;
    private HealthReport? webReport;
    private long webDurationMs;
    private bool isLoading;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        isLoading = true;
        StateHasChanged();

        var apiTask = HealthApi.CheckApiAsync();

        var sw = System.Diagnostics.Stopwatch.StartNew();
        webReport = await HealthChecks.CheckHealthAsync();
        sw.Stop();
        webDurationMs = sw.ElapsedMilliseconds;

        apiResult = await apiTask;
        isLoading = false;
    }

    private static string StatusClass(bool healthy) => healthy ? "ok" : "error";

    private static bool IsHealthy(string? status) =>
        string.Equals(status, "Healthy", StringComparison.OrdinalIgnoreCase);

    private static string OverallLabel(HealthProbeResult? result)
    {
        if (result is null) return "—";
        if (!result.Success) return result.StatusText;
        return result.Report?.Status ?? result.StatusText;
    }

    private static string CheckHint(string name)
    {
        var key = name.ToLowerInvariant();
        if (key is "self") return "Proces er i live";
        if (key.Contains("redis") || key is "cache") return "Redis-forbindelse";
        if (key.Contains("postgres") || key.Contains("npgsql") || key.Contains("h3db")) return "Postgres-forbindelse";
        return "Dependency check";
    }
}
